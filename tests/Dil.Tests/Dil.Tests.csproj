<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform; the repo-root global.json opts `dotnet test`
         into the MTP runner (the VSTest bridge is gone since the .NET 10 SDK). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.16" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <!-- Needed to drive the source generator directly in unit tests (the latest Roslyn; the
         generator itself stays on 4.8). Verify.SourceGenerators needs >= 4.9. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Snapshot testing for the generated output + diagnostics. -->
    <PackageReference Include="Verify.TUnit" Version="33.2.0" />
    <PackageReference Include="Verify.SourceGenerators" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference both as plain libraries: the runtime under test, and the generator so we can
         invoke it through CSharpGeneratorDriver. ReferenceOutputAssembly=true (the default) keeps
         them as references, not as analyzers applied to this project. -->
    <ProjectReference Include="..\..\src\Dil\Dil.csproj" />
    <ProjectReference Include="..\..\src\Dil.Generator\Dil.Generator.csproj" />
  </ItemGroup>

</Project>
