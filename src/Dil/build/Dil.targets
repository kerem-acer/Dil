<Project>

  <!--
    Live reload (re-reading resource files when they change on disk) is a development convenience, so
    it defaults to on for Debug builds only. Set <DilLiveReload>true|false</DilLiveReload> to override.
    The value reaches the runtime as the "Dil.LiveReload" runtimeconfig.json switch, which seeds
    Loc.LiveReload; it only takes effect in the app (executable) project.
  -->
  <PropertyGroup>
    <DilLiveReload Condition="'$(DilLiveReload)' == '' and '$(Configuration)' == 'Debug'">true</DilLiveReload>
    <DilLiveReload Condition="'$(DilLiveReload)' == ''">false</DilLiveReload>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Dil.LiveReload" Value="$(DilLiveReload)" />
  </ItemGroup>

  <!--
    The dedicated <DilResource Include="..." /> item is the way to register a resource. A source
    generator can only read AdditionalFiles, so project each one into an AdditionalFiles item here
    (at import time, so they are present when the generator runs). Referencing @(DilResource)
    carries over its metadata — including the per-resource Accessibility the generator reads — onto
    the new items; the literal DilResource="true" marks them as ours. The legacy
    <AdditionalFiles ... DilResource="true" /> form keeps working untouched.

  -->
  <ItemGroup>
    <AdditionalFiles Include="@(DilResource)" DilResource="true" />
  </ItemGroup>

  <!--
    Registering any one file of a set is enough: the rest of the set on disk (<dir>/<stem>.json and
    <dir>/<stem>.*.json — e.g. Strings.json and Strings.tr.json next to Strings.en.json) is pulled in
    automatically. AssignCulture (the task resx uses) drops the culture from each registered name
    first, so Strings.en.json searches for Strings.*.json rather than Strings.en.*.json; a trailing
    segment that isn't a culture (Order.New.json) stays part of the name. This runs in a target
    because a wildcard only globs inside a target (at static evaluation it stays literal). It hooks in
    before AssignTargetPaths (so the copy step below sees the siblings) and before the analyzer config
    / compile (so the generator sees them). Siblings copy the registered item's Accessibility and
    DefaultCulture, so the set's settings don't depend on which of its files was registered.
  -->
  <Target Name="_DilDiscoverSiblings"
          BeforeTargets="AssignTargetPaths;GenerateMSBuildEditorConfigFile;CoreCompile"
          Condition="'@(DilResource)' != ''">
    <AssignCulture Files="@(DilResource)">
      <Output TaskParameter="CultureNeutralAssignedFiles" ItemName="_DilSetFile" />
    </AssignCulture>
    <ItemGroup>
      <_DilSibling Include="%(_DilSetFile.RelativeDir)%(_DilSetFile.Filename)%(_DilSetFile.Extension);%(_DilSetFile.RelativeDir)%(_DilSetFile.Filename).*.json"
                   Accessibility="%(_DilSetFile.Accessibility)"
                   DefaultCulture="%(_DilSetFile.DefaultCulture)" />
      <!-- The neutral name is a literal, not a glob, so it is kept even when no such file exists. -->
      <_DilSibling Remove="@(_DilSibling)" Condition="!Exists('%(FullPath)')" />
      <!-- Drop any sibling already registered (explicitly or on a prior run) to avoid duplicates. -->
      <_DilSibling Remove="@(AdditionalFiles)" />
      <!-- Two registered files of one set with different metadata find the same siblings twice. -->
      <AdditionalFiles Include="@(_DilSibling->Distinct())" DilResource="true" />
    </ItemGroup>
  </Target>

  <!--
    Resource files marked with DilResource="true" are AdditionalFiles (so the generator
    can read them). AdditionalFiles are not copied to the output folder, but the runtime
    needs them there, so mirror each one as a copied None item (preserving its relative path).
  -->
  <Target Name="_DilCopyResources" BeforeTargets="AssignTargetPaths" DependsOnTargets="_DilDiscoverSiblings">
    <ItemGroup>
      <None Include="@(AdditionalFiles)"
            Condition="'%(AdditionalFiles.DilResource)' == 'true'"
            CopyToOutputDirectory="PreserveNewest"
            Link="%(AdditionalFiles.Identity)" />
    </ItemGroup>
  </Target>

</Project>
