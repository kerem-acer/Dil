<Project>

  <!-- Expose what the source generator needs to read from the consuming project. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="DilAccessibility" />
    <CompilerVisibleProperty Include="DilDefaultCulture" />
    <CompilerVisibleProperty Include="DilNamespace" />
    <CompilerVisibleProperty Include="DilNamespaceFromFolder" />
    <CompilerVisibleProperty Include="DilMemberNames" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DilResource" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Accessibility" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DefaultCulture" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Namespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MemberNames" />
  </ItemGroup>

</Project>
