<Project>

  <PropertyGroup>
    <!-- Style rules from .editorconfig / .globalconfig are enforced at build time and fail the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required for IDE0005 (unused usings) to run at build time. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible, lock-file-pinned restore (the CI cache keys off packages.lock.json). -->
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Package authorship + Source Link / symbols for debuggable, reproducible packages. -->
    <Authors>kerem-acer</Authors>
    <Copyright>Copyright (c) 2026 kerem-acer</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Embed the exact commit in package builds on CI (deterministic + Source Link). -->
  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test projects: relax rules that fight idiomatic test code (underscored names, etc.),
       mirroring Glot's own Directory.Build.props. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);CA1707;CA2012;MA0042;S6966;S2068;S5445;EPC29;IDE0370</NoWarn>
    <!-- Verify 33+ checks the Open Source Maintenance Fee at build time (SponsorCheck). Dil is an open
         source project that generates no revenue, so it claims the OpenSource exemption. The claim is
         time-bounded (at most 12 months out): once the month passes the build fails with SC021, so bump
         the date. https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <!-- Source Link only for shipping packages. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <!-- The repo-root .globalconfig (Glot's shared analyzer severities) is auto-discovered by the SDK. -->

</Project>
